PORT=5000
MONGO_URI=mongodb://localhost:27017/safetour
JWT_SECRET=replace-with-strong-secret
FRONTEND_ORIGIN=http://localhost:5173
ML_SERVICE_URL=http://localhost:8000
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Optional (for real OTP email sending)
# If SMTP_* are not set, OTP flow works in dev mode and returns debugCode in API response.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_email
SMTP_PASS=your_smtp_password_or_app_password
OTP_FROM_EMAIL=your_smtp_email

# Cloudinary (Evidence uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret
